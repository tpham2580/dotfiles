#!/usr/bin/env bash
#
# herdr-sessionizer — fzf picker for herdr workspaces, projects, and sessions.
# The herdr port of ~/.local/scripts/tmux-sessionizer.
#
# Concept map from tmux:
#   tmux session          -> herdr WORKSPACE   (switch in place, like switch-client)
#   tmux switch-client -t -> herdr workspace focus
#   tmux new-session -c   -> herdr workspace create --cwd
#
# A herdr *named session* is a separate server, so it can only be ATTACHED to,
# never switched to in place. Those rows are therefore hidden while inside herdr.
#
# Keys inside the picker:
#   enter   focus workspace / attach session, or create a workspace from a name
#           that matches nothing (it lands in the running session)
#   del     close workspace, or stop+delete a named session
#   ctrl-c  cancel
#
# Usage:
#   herdr-sessionizer              interactive picker
#   herdr-sessionizer <dir>        open a specific directory directly
#   herdr-sessionizer --list       print rows (used by fzf reload)
#   herdr-sessionizer --delete R   delete the entity described by row R
#
set -uo pipefail

HERDR="${HERDR_BIN_PATH:-herdr}"
ATTACH="$HOME/.script/herdr-attach"
PROJECT_DIRS=("$HOME/Projects" "$HOME")
TAB=$'\t'

# A popup gets HERDR_ACTIVE_PANE_ID; a normal pane gets HERDR_PANE_ID.
in_herdr() { [[ -n "${HERDR_PANE_ID:-}${HERDR_ACTIVE_PANE_ID:-}" ]]; }
server_up() { "$HERDR" workspace list >/dev/null 2>&1; }

# ---------------------------------------------------------------- row listing
# Row format:  TYPE \t ID \t DISPLAY
# Default view: active herdr entities only (workspaces + named sessions), plus a
# "create" row echoing the current query so a new name is always selectable even
# when it happens to fuzzy-match an existing workspace.
list_rows() {
  local query="${1:-}"
  local labels=()
  if server_up; then
    while IFS=$TAB read -r id label panes status; do
      [[ -z "$id" ]] && continue
      local unit="panes"; [[ "$panes" == "1" ]] && unit="pane"
      labels+=("$label")
      printf 'ws\t%s\t  %s\t(%s %s, %s)\n' "$id" "$label" "$panes" "$unit" "$status"
    done < <("$HERDR" workspace list 2>/dev/null \
      | jq -r '.result.workspaces[]? | "\(.workspace_id)\t\(.label)\t\(.pane_count)\t\(.agent_status)"' 2>/dev/null)
  fi

  # Named sessions are separate servers: attach only works from outside herdr.
  if ! in_herdr; then
    while read -r name status _; do
      [[ -z "$name" || "$name" == "name" ]] && continue
      printf 'ses\t%s\t  %s\t(session, %s)\n' "$name" "$name" "$status"
    done < <("$HERDR" session list 2>/dev/null | tail -n +2)
  fi

  # Labels are unique, so an exact hit is the existing workspace, not a new one.
  if [[ -n "$query" ]]; then
    local l
    for l in ${labels[@]+"${labels[@]}"}; do
      [[ "$l" == "$query" ]] && return 0
    done
    printf 'new\t%s\t  + create: %s\t(new workspace)\n' "$query" "$query"
  fi
}

# ------------------------------------------------------------------- deletion
delete_row() {
  local row="$1" type id
  type=$(cut -d"$TAB" -f1 <<<"$row")
  id=$(cut -d"$TAB" -f2 <<<"$row")
  case "$type" in
    ws)  "$HERDR" workspace close "$id" >/dev/null 2>&1 ;;
    ses)
      [[ "$id" == "default" ]] && exit 0   # never destroy the default session
      "$HERDR" session stop "$id"   >/dev/null 2>&1
      "$HERDR" session delete "$id" >/dev/null 2>&1
      ;;
    *) : ;;
  esac
}

# ----------------------------------------------------------------- create new
ensure_server() {
  server_up && return 0
  # `workspace create` needs a live server, so start one headlessly first.
  setsid nohup "$HERDR" server >/dev/null 2>&1 </dev/null &
  local i
  for i in $(seq 1 30); do
    server_up && return 0
    sleep 0.5
  done
  return 1
}

# A typed name that matches no row becomes a NEW workspace in the session that is
# already running, opened at the directory the picker was launched from.
create_named() {
  local name="$1" cwd id
  if ! ensure_server; then
    echo "herdr-sessionizer: could not start the herdr server" >&2
    exit 1
  fi
  cwd="${HERDR_ACTIVE_PANE_CWD:-$PWD}"
  id=$("$HERDR" workspace create --cwd "$cwd" --label "$name" 2>/dev/null \
    | jq -r '.result.workspace.workspace_id // empty')
  if [[ -z "$id" ]]; then
    echo "herdr-sessionizer: could not create workspace '$name'" >&2
    exit 1
  fi
  "$HERDR" workspace focus "$id" >/dev/null 2>&1
  in_herdr || exec "$ATTACH"
}

# ------------------------------------------------------------------- dispatch
dispatch() {
  local row="$1" type id
  [[ -z "$row" ]] && exit 0
  type=$(cut -d"$TAB" -f1 <<<"$row")
  id=$(cut -d"$TAB" -f2 <<<"$row")
  case "$type" in
    ws)
      "$HERDR" workspace focus "$id" >/dev/null 2>&1
      in_herdr || exec "$ATTACH"
      ;;
    ses)
      if [[ "$id" == "default" ]]; then exec "$ATTACH"; else exec "$ATTACH" --session "$id"; fi
      ;;
    new)
      create_named "$id"
      ;;
  esac
}

# ------------------------------------------------------------------ entrypoint
case "${1:-}" in
  --list)   shift; list_rows "${1:-}"; exit 0 ;;
  --delete) shift; delete_row "$1"; exit 0 ;;
  "")       ;;
  *)        echo "usage: herdr-sessionizer [--list|--delete ROW]" >&2
            echo "to open a folder as a workspace, use herdr-sessionize" >&2
            exit 2 ;;
esac

command -v fzf >/dev/null || { echo "fzf is required" >&2; exit 1; }

self="${BASH_SOURCE[0]}"

rows=$(list_rows)

# Feeding fzf nothing (rather than a blank line) keeps an empty server pickable,
# so a first workspace can still be created by name. `return 0` protects pipefail.
emit_rows() { [[ -n "$rows" ]] && printf '%s\n' "$rows"; return 0; }

# ctrl-n / ctrl-p are intentionally left unbound: they are fzf's own
# next/previous item movement.
# change:reload rebuilds the list on each keystroke so the "+ create" row always
# mirrors what is typed. --print-query stays as a fallback for a no-match enter.
# --no-sort keeps score ranking from floating the create row above real
# workspaces: existing rows stay in server order and "+ create" is always last,
# so enter still switches by default and creating is a deliberate move down.
out=$(
  emit_rows | fzf \
    --delimiter="$TAB" --with-nth=3.. \
    --prompt='herdr> ' --height=60% --reverse --ansi --no-multi --no-sort \
    --print-query \
    --header='enter: switch or create   del: close   ctrl-c: cancel' \
    --bind="change:reload($self --list {q})" \
    --bind="del:execute-silent($self --delete {})+reload($self --list {q})"
)
status=$?

# 130 = ctrl-c / esc, 2 = fzf error. 0 = row chosen, 1 = no match (create path).
[[ $status -eq 130 || $status -eq 2 ]] && exit 0

query=$(sed -n 1p <<<"$out")
selected=$(sed -n 2p <<<"$out")

if [[ -n "$selected" ]]; then
  dispatch "$selected"
elif [[ -n "$query" ]]; then
  create_named "$query"
fi
