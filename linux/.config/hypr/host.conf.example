# hypr host.conf — the parts of the Hyprland config that differ per machine.
#
# install.sh copies this file to ~/.config/hypr/host.conf only when that file
# does not already exist, so your monitor layout survives every later run of
# install.sh and every `git pull`. It is sourced from the top of hyprland.conf.
#
# Uncomment the block that matches the machine, or write your own.
# `hyprctl monitors` lists the connector names (eDP-1, DP-2, HDMI-A-1, ...).

# --- monitors ---------------------------------------------------------------
# Format: monitor = NAME, RESOLUTION@HZ, POSITION, SCALE [, transform, N]
# transform 1 = rotated 90° left.

# Laptop, single built-in panel (default — safe on any machine).
monitor = eDP-1, 1920x1080@60, 0x0, 1.0
# Catch-all so an unknown display still lights up.
monitor = , preferred, auto, 1

# Desktop, dual monitor:
#   DP-3 (Dell S2417DG) primary at 165Hz
#   DP-2 (ViewSonic VX2478) rotated left, to the left of primary
# monitor = DP-3, 2560x1440@165, 1440x0, 1
# monitor = DP-2, 2560x1440@60, 0x0, 1, transform, 1

# G15 Strix, built-in + external at 1440p165, DP-1 on the left:
# monitor = DP-1, 2560x1440@165, 0x0, 1
# monitor = eDP-1, 2560x1440@165, 2560x0, 1

# --- workspace placement ----------------------------------------------------
# Which monitor each workspace opens on. Only meaningful with more than one
# output, so it lives here rather than in the shared config.
# workspace = 1, monitor:DP-3, default:true
# workspace = 2, monitor:DP-3
# workspace = 3, monitor:DP-3
# workspace = 4, monitor:DP-3
# workspace = 5, monitor:DP-3
# workspace = 6, monitor:DP-2
# workspace = 7, monitor:DP-2
# workspace = 8, monitor:DP-2

# Some XWayland apps read the X11 primary output when deciding where to open.
# exec-once = xrandr --output DP-3 --primary

# --- wallpaper --------------------------------------------------------------
# One swaybg per output. `-m fill` crops to fit, `-m fit` letterboxes.
exec = swaybg -m fill -i ~/.config/hypr/sledge-catppuccin.jpg

# Desktop version (per-output, matching the rotated DP-2 above):
# exec = swaybg -o DP-2 -m fit -i ~/.config/hypr/sledge-catppuccin.jpg & swaybg -o DP-3 -m fill -i ~/.config/hypr/sledge-catppuccin.jpg

# --- Hyprland version compatibility -----------------------------------------
# Machines can run different Hyprland versions, so version-specific options
# belong here rather than in the shared config.
#
# Hyprland < 0.55 only: pseudotile is the master switch for pseudotiling, and
# the mainMod + P binding does nothing without it. The option was REMOVED in
# 0.55, so setting it there produces a config error — keep it commented out on
# 0.55 and newer. Check with `hyprctl version`.
# dwindle {
#     pseudotile = yes
# }

# --- polkit authentication agent --------------------------------------------
# Path depends on which desktop libraries the machine has installed.
# Arch + polkit-gnome:
exec-once = /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
# Fedora + polkit-gnome:
# exec-once = /usr/libexec/polkit-gnome-authentication-agent-1
# KDE (polkit-kde-agent):
# exec-once = /usr/libexec/kf6/polkit-kde-authentication-agent-1
# exec-once = /usr/lib/polkit-kde-authentication-agent-1
