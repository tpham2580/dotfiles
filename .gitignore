# --- Claude Code: keep the config, drop the runtime state -------------------
# Everything except settings.json and agents/ is per-machine runtime state.
# projects/ in particular holds full conversation transcripts, which routinely
# contain source code and credentials from whatever machine wrote them.
.claude/*
!.claude/settings.json
!.claude/agents/
.claude/agents/**/*.jsonl

# --- Codex: keep the config, drop the runtime state -------------------------
.codex/*
!.codex/AGENTS.md
!.codex/config.toml

# --- Runtime / state that must never be committed ---------------------------
# herdr writes logs, sockets and live session state next to its config.
linux/.config/herdr/*.log
linux/.config/herdr/*.sock
linux/.config/herdr/session.json
linux/.config/herdr/sessions/
linux/.config/herdr/.plugins.lock

# hunk records the last-seen CLI version here.
linux/.config/hunk/state.json
windows/.config/hunk/state.json

# Windows herdr lives in %APPDATA%; keep the config, drop the runtime state.
windows/AppData/Roaming/herdr/*.log
windows/AppData/Roaming/herdr/*.sock
windows/AppData/Roaming/herdr/session.json
windows/AppData/Roaming/herdr/sessions/
windows/AppData/Roaming/herdr/.plugins.lock

# Windows Terminal rewrites its LocalState on every launch; only the settings
# are configuration, the rest is per-machine runtime state.
windows/AppData/Local/Packages/*/LocalState/state.json
windows/AppData/Local/Packages/*/LocalState/elevated-state.json
windows/AppData/Local/Packages/*/LocalState/*.backup

# GlazeWM and Zebar write their crash logs next to their configs, and Zebar
# records marketplace install receipts (timestamps) under .marketplace/.
windows/.glzr/**/errors.log
windows/.glzr/zebar/.marketplace/

# ~/.copilot holds Copilot CLI runtime state (transcripts, session state), so
# only the herdr helper scripts are tracked out of it. The herdr and hunk skills
# are generated by install.ps1 from the installed binaries, not tracked here.
windows/.copilot/*
!windows/.copilot/scripts/
windows/.copilot/scripts/*
!windows/.copilot/scripts/*Herdr*.ps1

# Neovim installs plugins itself; only the lockfile is tracked.
linux/.config/nvim/pack/
linux/.config/nvim/plugin/
windows/.config/nvim/pack/
windows/.config/nvim/plugin/

# Never commit a machine's resolved host config. It is seeded from
# host.conf.example per machine. This is a safety net for setups where
# ~/.config/hypr is symlinked into the repo, which would otherwise drop the
# file straight into the working tree.
linux/.config/hypr/host.conf

# --- Editor / OS noise ------------------------------------------------------
*.bak
*.bak-*
*.swp
*.swo
*~
.DS_Store
Thumbs.db
